# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/meeting_prep_agent?schema=public"

# ---------------------------------------------------------------------------
# NextAuth
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Google OAuth (Calendar + Gmail)
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
# Enable the Google Calendar API and Gmail API for the project.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---------------------------------------------------------------------------
# AI provider
# Leave ANTHROPIC_API_KEY unset to use the built-in deterministic mock
# generator, which is enough to fully explore the app locally.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=""
AI_MODEL="claude-sonnet-5"

# ---------------------------------------------------------------------------
# Local development convenience
# Set to "true" to enable a one-click demo login (seeded demo user) so the
# app can be explored without configuring Google OAuth. Never enable this in
# a real production deployment.
# ---------------------------------------------------------------------------
ENABLE_DEMO_LOGIN="true"
